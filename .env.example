APP_NAME="Analise Roland Advisory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Needed for the admin panel (/admin) and for storing lead-form submissions.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=analiseroland
DB_USERNAME=root
DB_PASSWORD=

# The one admin login, created by `php artisan db:seed`. Change these before
# seeding — the seeder skips itself if either is left blank.
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@analiseroland.com"
MAIL_FROM_NAME="${APP_NAME}"

# Contact points surfaced in the nav and the floating WhatsApp button.
# SITE_WHATSAPP is international format, digits only — no +, spaces, or dashes.
SITE_PHONE="+8801779440297"
SITE_WHATSAPP=15550000000

# Where a copy of every contact-form submission is emailed.
SITE_ADMIN_EMAIL="hello@analiseroland.com"
